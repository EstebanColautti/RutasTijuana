{
  "editor.detectIndentation": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.DS_Store": true,
    "**/xcuserdata": true,
    "**/DerivedData": true,
    "build": true
  },
  "search.exclude": {
    "**/build": true,
    "**/DerivedData": true,
    "**/xcuserdata": true
  },
  "swift.autoGenerateLaunchConfigurations": false,
  "swift.backgroundCompilation": false,
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.tabSize": 4
  },
  "[json]": {
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.tabSize": 2
  }
}
